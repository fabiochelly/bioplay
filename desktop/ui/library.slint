// bioplay : la bibliothèque, dans sa propre fenêtre.
//
// Verre dépoli : la fenêtre est transparente, Hyprland floute le fond d'écran derrière, et
// l'interface ne peint qu'un voile sombre puis ses éléments. La vidéo, elle, s'ouvre dans la
// fenêtre de mpv (préparé à l'avance) ; celle-ci se cache pendant la lecture.
//
// Icônes : tracés au trait (dessins Lucide, ISC) dans une viewbox de 24.

import { ListView } from "std-widgets.slint";
import "../../app/src/main/assets/inter-medium.ttf";
import "../../app/src/main/assets/inter-semibold.ttf";

// Un élément de la grille : dossier (kind 0) ou vidéo (kind 1).
export struct Tile {
    kind: int,
    id: int,
    name: string,
    detail: string,
    duration: string,
    progress: float,
    image: image,
    has-image: bool,
}

export struct Row { tiles: [Tile] }

export struct FolderItem { id: int, name: string, path: string, count: string }

export global Theme {
    out property <color> ink: #eef1f5;
    out property <color> ink2: #eef1f5a8;
    out property <color> faint: #eef1f566;
    out property <color> accent: #8fd8ff;
    // Voile de la vitre : sombre, bleuté, un peu plus dense en bas.
    out property <color> glass-top: #05080f4d;
    out property <color> glass-bottom: #05080f73;
    out property <color> plate: #ffffff12;
    out property <color> plate-hover: #ffffff24;
    out property <color> line: #ffffff2e;
}

export global Icons {
    out property <string> open: "M6 14l1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2";
    out property <string> folder: "M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z";
    out property <string> grid: "M4 3h5a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z M15 3h5a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1h-5a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z M15 14h5a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1h-5a1 1 0 0 1-1-1v-5a1 1 0 0 1 1-1z M4 14h5a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-5a1 1 0 0 1 1-1z";
    out property <string> rows: "M8 6h13 M8 12h13 M8 18h13 M3 6h.01 M3 12h.01 M3 18h.01";
    out property <string> back: "M15 18l-6-6 6-6";
    out property <string> close: "M18 6L6 18 M6 6l12 12";
    out property <string> plus: "M5 12h14 M12 5v14";
    out property <string> play: "M7 4l13 8-13 8z";
}

component Glyph inherits Path {
    in property <color> color: Theme.ink;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: color;
    stroke-width: 2px;
    fill: transparent;
}

// Bouton rond en verre, icône seule.
component RoundButton inherits Rectangle {
    in property <string> icon;
    callback clicked;
    width: 44px;
    height: 44px;
    border-radius: self.height / 2;
    background: ta.has-hover ? Theme.plate-hover : Theme.plate;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.accent.with-alpha(0.7) : Theme.line;
    animate background, border-color { duration: 120ms; }
    Glyph {
        width: 21px;
        height: 21px;
        commands: root.icon;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Drapeaux de la bascule de langue, dessinés (pas de caractère, pas d'image).
component FlagFr inherits Rectangle {
    clip: true;
    border-radius: 2px;
    HorizontalLayout {
        Rectangle { background: #0055a4; }
        Rectangle { background: #ffffff; }
        Rectangle { background: #ef4135; }
    }
}

component FlagGb inherits Rectangle {
    clip: true;
    border-radius: 2px;
    background: #012169;
    Path { viewbox-width: 60; viewbox-height: 30; width: 100%; height: 100%; commands: "M0 0L60 30 M60 0L0 30"; stroke: #ffffff; stroke-width: parent.height / 5; fill: transparent; }
    Path { viewbox-width: 60; viewbox-height: 30; width: 100%; height: 100%; commands: "M0 0L60 30 M60 0L0 30"; stroke: #c8102e; stroke-width: parent.height / 12; fill: transparent; }
    Rectangle { width: 100%; height: parent.height / 3; background: #ffffff; }
    Rectangle { height: 100%; width: parent.height / 3; background: #ffffff; }
    Rectangle { width: 100%; height: parent.height / 5; background: #c8102e; }
    Rectangle { height: 100%; width: parent.height / 5; background: #c8102e; }
}

component LangSwitch inherits Rectangle {
    in property <bool> en;
    callback choose(bool);
    height: 44px;
    width: 96px;
    border-radius: self.height / 2;
    background: Theme.plate;
    border-width: 1px;
    border-color: Theme.line;
    HorizontalLayout {
        padding: 4px;
        spacing: 2px;
        for e in [false, true]: Rectangle {
            border-radius: self.height / 2;
            background: (e == root.en) ? Theme.accent.with-alpha(0.22) : t.has-hover ? Theme.plate : transparent;
            Rectangle {
                width: 24px;
                height: 16px;
                opacity: (e == root.en) ? 1 : 0.5;
                if !e: FlagFr { width: 100%; height: 100%; }
                if e: FlagGb { width: 100%; height: 100%; }
            }
            t := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.choose(e); }
            }
        }
    }
}

// Dossier dessiné : dos, deux feuilles qui se soulèvent au survol, face en dégradé.
component FolderArt inherits Rectangle {
    in property <bool> hovered;
    property <length> h: self.height * 0.86;
    property <length> w: min(self.width * 0.86, self.h * 1.42);
    property <length> x0: (self.width - self.w) / 2;
    property <length> y0: (self.height - self.h) / 2 + self.height * 0.02;
    property <length> lift: root.hovered ? -3px : 0px;
    property <length> r: self.h * 0.07;
    // Onglet et dos.
    Rectangle { x: root.x0; y: root.y0; width: root.w * 0.38; height: root.h * 0.22; border-radius: root.r; background: #2b6db3; }
    Rectangle { x: root.x0; y: root.y0 + root.h * 0.1; width: root.w; height: root.h * 0.9; border-radius: root.r; background: @linear-gradient(180deg, #2b6db3 0%, #173f70 100%); }
    // Feuilles.
    Rectangle {
        x: root.x0 + root.w * 0.08; y: root.y0 + root.h * 0.17 + root.lift; width: root.w * 0.8; height: root.h * 0.5;
        border-radius: root.h * 0.04; background: #cfddeb;
        animate y { duration: 140ms; }
    }
    Rectangle {
        x: root.x0 + root.w * 0.13; y: root.y0 + root.h * 0.23 + root.lift * 1.6; width: root.w * 0.76; height: root.h * 0.5;
        border-radius: root.h * 0.04; background: #f1f6fb;
        animate y { duration: 140ms; }
    }
    // Face.
    Rectangle {
        x: root.x0; y: root.y0 + root.h * 0.33; width: root.w; height: root.h * 0.67;
        border-radius: root.r;
        background: @linear-gradient(180deg, #8fd8ff 0%, #4fb2f0 50%, #2f86cf 100%);
        Rectangle { x: root.r; y: 1px; width: parent.width - 2 * root.r; height: 1.5px; background: #ffffffaa; }
    }
}

// Image d'une vidéo : miniature arrondie, durée, avancée de lecture ; liseré bleu au survol.
component Thumb inherits Rectangle {
    in property <Tile> t;
    in property <bool> hovered;
    // Pastille de durée (pas en liste : la durée y est écrite à côté).
    in property <bool> badge: true;
    Rectangle {
        border-radius: 12px;
        clip: true;
        background: #ffffff0e;
        if root.t.has-image: Image {
            width: parent.width;
            height: parent.height;
            source: root.t.image;
            image-fit: cover;
        }
        if !root.t.has-image: Glyph {
            width: 26px;
            height: 26px;
            commands: Icons.play;
            color: Theme.faint;
        }
        if root.badge && root.t.duration != "": Rectangle {
            x: parent.width - self.width - 8px;
            y: 7px;
            height: 18px;
            width: d.preferred-width + 12px;
            border-radius: 9px;
            background: #00000096;
            d := Text { text: root.t.duration; font-size: 11px; font-weight: 600; color: Theme.ink; }
        }
        if root.t.duration != "": Rectangle {
            x: 9px;
            y: parent.height - 11px;
            width: parent.width - 18px;
            height: 4px;
            border-radius: 2px;
            background: #ffffff2a;
            Rectangle {
                x: 0;
                width: root.t.progress > 0 ? max(4px, parent.width * root.t.progress) : 0px;
                height: 100%;
                border-radius: 2px;
                background: Theme.accent;
            }
        }
    }
    Rectangle {
        border-radius: 12px;
        border-width: root.hovered ? 2.5px : 1px;
        border-color: root.hovered ? Theme.accent : #ffffff22;
    }
}

component GridTile inherits Rectangle {
    in property <Tile> t;
    in property <length> th;
    callback activate;
    if root.t.kind == 0: FolderArt { y: 0; height: root.th; hovered: ta.has-hover; }
    if root.t.kind == 1: Thumb { y: 0; height: root.th; t: root.t; hovered: ta.has-hover; }
    Text {
        x: 2px;
        y: root.th + 7px;
        width: parent.width - 4px;
        height: root.t.kind == 0 ? 18px : 36px;
        text: root.t.name;
        wrap: word-wrap;
        overflow: elide;
        vertical-alignment: top;
        font-size: 13.5px;
        font-weight: 600;
        color: Theme.ink;
    }
    if root.t.kind == 0: Text {
        x: 2px;
        y: root.th + 26px;
        text: root.t.detail;
        font-size: 11.5px;
        color: Theme.ink2;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activate(); }
    }
}

component ListTile inherits Rectangle {
    in property <Tile> t;
    callback activate;
    border-radius: 16px;
    background: ta.has-hover ? #ffffff0e : transparent;
    if root.t.kind == 0: FolderArt { x: 6px; y: 4px; width: 128px; height: 72px; hovered: ta.has-hover; }
    if root.t.kind == 1: Thumb { x: 6px; y: 4px; width: 128px; height: 72px; t: root.t; hovered: ta.has-hover; badge: false; }
    VerticalLayout {
        x: 150px;
        width: parent.width - 162px;
        alignment: center;
        spacing: 4px;
        Text {
            text: root.t.name;
            wrap: word-wrap;
            overflow: elide;
            max-height: 40px;
            font-size: 15px;
            font-weight: 600;
            color: Theme.ink;
        }
        Text { text: root.t.detail; font-size: 12px; color: Theme.ink2; overflow: elide; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activate(); }
    }
}

// Liste des dossiers surveillés : retirer, ajouter.
component FoldersSheet inherits Rectangle {
    in property <bool> en;
    in property <[FolderItem]> folders;
    callback close;
    callback add;
    callback remove(int);
    background: #00000066;
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        width: min(560px, parent.width - 48px);
        height: min(parent.height - 120px, 140px + 64px * max(1, root.folders.length));
        border-radius: 24px;
        background: #0d1320f0;
        border-width: 1px;
        border-color: Theme.line;
        TouchArea { }
        VerticalLayout {
            padding: 22px;
            spacing: 10px;
            HorizontalLayout {
                Text { text: root.en ? "Folders" : "Dossiers"; font-size: 20px; font-weight: 600; color: Theme.ink; vertical-alignment: center; }
                Rectangle { }
                RoundButton { icon: Icons.close; clicked => { root.close(); } }
            }
            if root.folders.length == 0: Text {
                text: root.en ? "No folder yet." : "Aucun dossier pour l'instant.";
                color: Theme.ink2;
                font-size: 13px;
            }
            for f in root.folders: Rectangle {
                height: 54px;
                border-radius: 14px;
                background: Theme.plate;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 6px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Text { text: f.name + "  ·  " + f.count; font-size: 14px; font-weight: 600; color: Theme.ink; overflow: elide; }
                        Text { text: f.path; font-size: 11px; color: Theme.faint; overflow: elide; }
                    }
                    RoundButton { y: 5px; icon: Icons.close; clicked => { root.remove(f.id); } }
                }
            }
            Rectangle { }
            Rectangle {
                height: 44px;
                border-radius: 22px;
                background: add-ta.has-hover ? Theme.accent.with-alpha(0.3) : Theme.accent.with-alpha(0.18);
                border-width: 1px;
                border-color: Theme.accent.with-alpha(0.6);
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    Glyph { y: 12px; width: 20px; height: 20px; commands: Icons.plus; }
                    Text { text: root.en ? "Add a folder" : "Ajouter un dossier"; font-size: 14px; font-weight: 600; color: Theme.ink; vertical-alignment: center; }
                }
                add-ta := TouchArea { mouse-cursor: pointer; clicked => { root.add(); } }
            }
        }
    }
}

export component LibraryWindow inherits Window {
    title: "bioplay";
    background: transparent;
    preferred-width: 1280px;
    preferred-height: 800px;
    default-font-family: "Inter";
    forward-focus: keys;

    in property <bool> en;
    in property <[Row]> rows;
    in property <bool> grid: true;
    in property <length> tile-w: 230px;
    in property <length> th: 130px;
    in property <string> place-title;
    in property <bool> can-up;
    in property <int> folder-count;
    in property <[FolderItem]> folders;
    // Message à la place de la grille (pas de dossier, recherche, rien trouvé) ; vide sinon.
    in property <string> empty;
    in property <bool> empty-add;
    in-out property <bool> sheet;

    callback open-file;
    callback toggle-view;
    callback set-lang(bool);
    callback up;
    callback activate(int, int);
    callback add-folder;
    callback remove-folder(int);
    callback relayout(length);

    changed width => { root.relayout(self.width); }
    init => { root.relayout(self.width); }

    property <length> side: 28px;
    property <length> body-top: 20px + 44px + 14px + (root.can-up ? 54px : 0px);

    // La vitre.
    Rectangle { background: @linear-gradient(180deg, Theme.glass-top 0%, Theme.glass-bottom 100%); }

    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                if root.sheet { root.sheet = false; } else { root.up(); }
                return accept;
            }
            if e.text == Key.Backspace { root.up(); return accept; }
            reject
        }
    }

    // Barre du haut.
    RoundButton { x: root.side; y: 20px; icon: Icons.open; clicked => { root.open-file(); } }
    Rectangle {
        x: root.side + 44px + 10px;
        y: 20px;
        height: 44px;
        width: pill.preferred-width;
        border-radius: 22px;
        background: pill-ta.has-hover ? Theme.plate-hover : Theme.plate;
        border-width: 1px;
        border-color: pill-ta.has-hover ? Theme.accent.with-alpha(0.7) : Theme.line;
        pill := HorizontalLayout {
            padding-left: 14px;
            padding-right: 18px;
            spacing: 8px;
            Glyph { y: 12px; width: 20px; height: 20px; commands: Icons.folder; }
            Text { text: root.en ? "Folders" : "Dossiers"; font-size: 15px; font-weight: 600; color: Theme.ink; vertical-alignment: center; }
            if root.folder-count > 0: Text { text: root.folder-count; font-size: 15px; font-weight: 600; color: Theme.accent; vertical-alignment: center; }
        }
        pill-ta := TouchArea { mouse-cursor: pointer; clicked => { root.sheet = true; } }
    }
    RoundButton {
        x: root.width - root.side - 96px - 10px - 44px;
        y: 20px;
        icon: root.grid ? Icons.rows : Icons.grid;
        clicked => { root.toggle-view(); }
    }
    LangSwitch {
        x: root.width - root.side - 96px;
        y: 20px;
        en: root.en;
        choose(e) => { root.set-lang(e); }
    }

    // Dossier en cours : remonter, et son nom.
    if root.can-up: RoundButton {
        x: root.side;
        y: 20px + 44px + 14px + 2px;
        width: 40px;
        height: 40px;
        icon: Icons.back;
        clicked => { root.up(); }
    }
    if root.can-up: Text {
        x: root.side + 52px;
        y: 20px + 44px + 14px + 2px;
        height: 40px;
        width: root.width - root.side * 2 - 52px;
        text: root.place-title;
        font-size: 18px;
        font-weight: 600;
        color: Theme.ink;
        vertical-alignment: center;
        overflow: elide;
    }

    if root.empty == "": ListView {
        y: root.body-top;
        height: root.height - root.body-top;
        for row in root.rows: Rectangle {
            height: root.grid ? root.th + 50px : 86px;
            for t[j] in row.tiles: Rectangle {
                x: root.grid ? root.side + j * (root.tile-w + 16px) : root.side;
                width: root.grid ? root.tile-w : root.width - root.side * 2;
                height: parent.height - 6px;
                y: 3px;
                if root.grid: GridTile {
                    t: t;
                    th: root.th;
                    activate => { root.activate(t.kind, t.id); }
                }
                if !root.grid: ListTile {
                    t: t;
                    activate => { root.activate(t.kind, t.id); }
                }
            }
        }
    }
    if root.empty != "": VerticalLayout {
        y: root.body-top;
        height: root.height - root.body-top - 80px;
        alignment: center;
        spacing: 18px;
        Text { text: root.empty; font-size: 16px; color: Theme.ink2; horizontal-alignment: center; }
        if root.empty-add: HorizontalLayout {
            alignment: center;
            Rectangle {
                width: add-label.preferred-width + 48px;
                height: 44px;
                border-radius: 22px;
                background: empty-ta.has-hover ? Theme.accent.with-alpha(0.3) : Theme.accent.with-alpha(0.18);
                border-width: 1px;
                border-color: Theme.accent.with-alpha(0.6);
                add-label := Text { text: root.en ? "Add a folder" : "Ajouter un dossier"; font-size: 14px; font-weight: 600; color: Theme.ink; }
                empty-ta := TouchArea { mouse-cursor: pointer; clicked => { root.add-folder(); } }
            }
        }
    }

    if root.sheet: FoldersSheet {
        en: root.en;
        folders: root.folders;
        close => { root.sheet = false; }
        add => { root.add-folder(); }
        remove(id) => { root.remove-folder(id); }
    }
}
