<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic" android:duration="260">
    <translate android:fromYDelta="40%" android:toYDelta="0" />
    <alpha android:fromAlpha="0" android:toAlpha="1" />
    <scale android:fromXScale="0.96" android:toXScale="1" android:fromYScale="0.96" android:toYScale="1"
        android:pivotX="50%" android:pivotY="100%" />
</set>
